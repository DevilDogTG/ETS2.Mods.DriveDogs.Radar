SiiNunit
{
# Strobe on every fining speed camera model (locators injected by tools/build_mod.py). Always on.
flare_blink : ddradar.blink
{
	dir_type: wide
	blink_pattern: "X-X-XXX-----------"
	blink_step_length: 0.06

	light_type: police_hooter

	type: spot
	setup: candela_hue_saturation
	diffuse_color: (200, 0, 100)
	specular_color: (200, 0, 100)
	range: 25
	forward_distance: false
	inner_angle: 5
	outer_angle: 90
	fade_distance: 100
	fade_span: 50

	model: "/model/flare/uniform_red_amplified.pmd"
	default_scale: 1.35
	scale_factor: 3

	state_change_duration: 0.083
}

# Truck-part flares MUST be named flare.vehicle.* - the engine ignores other hookup names on vehicle
# models (dev.6: all four test variants named ddradar.cab_* showed nothing, not even the always-on
# one; every light hookup on base truck models is flare.vehicle.*). World models (cameras) don't care.
#
# Windshield detector indicator: blinks police-style only while the truck's aux light state is on.
flare_blink : flare.vehicle.ddr_blink
{
	dir_type: wide
	blink_pattern: "X-X-XXX-----------"
	blink_step_length: 0.06

	light_type: aux

	type: spot
	setup: candela_hue_saturation
	diffuse_color: (20, 0, 100)
	specular_color: (20, 0, 100)
	range: 1.5
	forward_distance: false
	inner_angle: 30
	outer_angle: 120

	model: "/model/flare/uniform_red.pmd"
	default_scale: 0.15
	scale_factor: 1

	state_change_duration: 0.083
}

# Hidden aux emitter (no flare model, near-zero light). Not enough on its own to enable the aux
# control (test 2026-10-07); the accessory def also declares `electric_type: aux_light`.
flare_vehicle : flare.vehicle.ddr_aux
{
	dir_type: wide
	light_type: aux

	type: spot
	setup: candela_hue_saturation
	diffuse_color: (0.01, 0, 0)
	specular_color: (0.01, 0, 0)
	range: 0.05
	forward_distance: false
	inner_angle: 5
	outer_angle: 10
}

# ---- TEST (dev.4) cab flare variants: round 4 showed nothing in the cab with roof aux on.
# Visuals copied from base vehicle beacons (amplified flare model, fake_interior_offset), which do show
# from inside the cab. fake_interior_offset exists only on flare_blink / beacon_vehicle - on
# flare_vehicle it fails the whole file (round 5), so variant D goes without it.
flare_blink : flare.vehicle.ddr_test_a
{
	dir_type: wide
	blink_pattern: "X-X-XXX-----------"
	blink_step_length: 0.06

	light_type: aux

	type: spot
	setup: candela_hue_saturation
	diffuse_color: (60, 0, 100)
	specular_color: (60, 0, 100)
	range: 2.0
	forward_distance: false
	inner_angle: 30
	outer_angle: 120

	model: "/model/flare/uniform_red_amplified.pmd"
	default_scale: 0.632
	scale_factor: 3
	fake_interior_offset: 1.5

	state_change_duration: 0.083
}

flare_blink : flare.vehicle.ddr_test_c
{
	dir_type: wide
	blink_pattern: "X-X-XXX-----------"
	blink_step_length: 0.06

	light_type: electrics

	type: spot
	setup: candela_hue_saturation
	diffuse_color: (60, 0, 100)
	specular_color: (60, 0, 100)
	range: 2.0
	forward_distance: false
	inner_angle: 30
	outer_angle: 120

	model: "/model/flare/uniform_red_amplified.pmd"
	default_scale: 0.632
	scale_factor: 3
	fake_interior_offset: 1.5

	state_change_duration: 0.083
}

flare_vehicle : flare.vehicle.ddr_test_d
{
	dir_type: wide
	light_type: aux

	type: spot
	setup: candela_hue_saturation
	diffuse_color: (60, 0, 100)
	specular_color: (60, 0, 100)
	range: 2.0
	forward_distance: false
	inner_angle: 30
	outer_angle: 120

	model: "/model/flare/uniform_red_amplified.pmd"
	default_scale: 0.632
	scale_factor: 3
}
}
